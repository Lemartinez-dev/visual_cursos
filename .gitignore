# ==============================================================================
# VirtualizaCore - .gitignore
# Backend Python (FastAPI MVC) + Frontend React 18 + Supabase / Cloudflare Pages
# ==============================================================================

# 1. Variables de Entorno y Secretos (Seguridad)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Conservar la plantilla pública de variables de entorno
!.env.example

# 2. Python y Entornos Virtuales
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 3. Cloudflare Pages & Wrangler CLI
.wrangler/
.cloudflare/

# 4. Node & Gestores de Paquetes (en caso de usar herramientas JS auxiliares)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. Archivos Subidos por Usuarios (Almacenamiento Local de Prueba)
frontend/uploads/*
!frontend/uploads/.gitkeep

# 6. Editores de Código e IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# 7. Archivos de Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 8. Logs y Archivos Temporales
*.log
*.tmp
*.bak
